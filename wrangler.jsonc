// Static site on Cloudflare Workers (free plan). Deploy with: npx.cmd wrangler@4 deploy
{
  "name": "aven",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{ "pattern": "aventrade.app", "custom_domain": true }, { "pattern": "www.aventrade.app", "custom_domain": true }],
  "assets": { "directory": "./site", "not_found_handling": "404-page" }
}
